# ===========================
# AI Provider Configuration
# ===========================

# Default AI Provider (when using "auto" mode)
# Options: copilot-proxy, openai, gemini
# Set to "copilot-proxy" to use Claude Sonnet 4.5 via GitHub Copilot Pro
DEFAULT_AI_PROVIDER=copilot-proxy

# Copilot Proxy (Claude Sonnet 4.5 via GitHub Copilot Pro)
# Extension: https://github.com/lutzleonhardt/copilot-proxy
# Requires: copilot-proxy extension running in VSCode
COPILOT_PROXY_URL=http://localhost:3016
COPILOT_PROXY_MODEL=claude-sonnet-4.5

# OpenAI (Paid)
# Get API key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here

# Google Gemini (Free Tier)
# Get API key: https://ai.google.dev/
# GEMINI_API_KEY=your-gemini-key-here

# ===========================
# Application Configuration
# ===========================

# Server
PORT=3000

# Storage
APP_STORAGE_DIR=./storage

# ===========================
# Notes
# ===========================
# Priority (when using "auto" provider):
# 1. Copilot Proxy (if running on port 3016)
# 2. OpenAI (if API key is set)
# 3. Gemini (if API key is set)
